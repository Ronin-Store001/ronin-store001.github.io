{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
        },
        "prem": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
        },
        "premExp": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
        }
      }
    },
    "posts": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "products": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "news": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "events": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "cinema": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "anime": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "groups": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "groupMsgs": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "groupInvites": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "follows": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "followers": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "votes": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "online": {
      ".read": true,
      "$id": {
        ".write": "auth != null"
      }
    },
    "bm": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "dm": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "dmBox": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "notifs": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "typing": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "orders": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
      "$id": {
        ".write": "auth != null"
      }
    },
    "pending": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "settings": {
      "brand": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      },
      "site": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      },
      "teamNote": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      },
      "teamPin": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "team": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "teamTasks": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "chatPlus": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "userQuestions": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "campaigns": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "premreq": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        "st": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
        },
        "price": {
          ".write": "auth != null && !data.exists()"
        },
        "by": {
          ".validate": "newData.val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'owner'"
        },
        "days": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365"
        },
        "at": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "ads": {
      "campaigns": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        "$id": {
          ".validate": "newData.hasChildren(['title', 'video']) || !newData.exists()",
          "video": {
            ".validate": "newData.isString() && newData.val().length < 500"
          },
          "poster": {
            ".validate": "newData.isString() && newData.val().length < 500"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "live": {
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "stats": {
        ".read": "auth != null",
        "$cid": {
          "$metric": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "site": {
      "contact": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",
        ".write": true,
        "$id": {
          ".validate": "newData.hasChildren(['name', 'msg'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "contact": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "topic": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "msg": {
            ".validate": "newData.isString() && newData.val().length <= 1500"
          },
          "at": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "views": {
        ".read": true,
        "$page": {
          ".write": true,
          "$day": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "prefs": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "$other": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
